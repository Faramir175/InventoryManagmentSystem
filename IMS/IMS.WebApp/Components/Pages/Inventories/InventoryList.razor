@page "/inventories"

<h3>Inventory List</h3>

<br />
<br />

<SearchComponent OnSearch="HandleSearch"></SearchComponent>

<br />

<InventoryListComponent searhInventoryFilter="@inventoryNameFilter"></InventoryListComponent>

<br />

<a href="/addinventory" class="btn btn-primary">Add inventory</a>

@code {
    private string? inventoryNameFilter = string.Empty;
    private void HandleSearch(string searchFilter)
    {
        inventoryNameFilter = searchFilter;
    }
}