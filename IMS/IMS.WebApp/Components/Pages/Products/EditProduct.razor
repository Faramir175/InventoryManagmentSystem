@page "/editproduct/{prodId:guid}"
@attribute [Authorize(Policy = "Inventory")]

@rendermode InteractiveServer

@inject IEditProductUseCase EditProductUseCase
@inject IViewProductByIdUseCase ViewProductByIdUseCase
@inject NavigationManager NavigationManager

<h3>Edit Product</h3>
<br />
@if (editProduct is not null)
{
    <EditForm Model="editProduct" OnValidSubmit="Update">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div class="form-group mb-3">
            <label for="name" class="form-label">Name</label>
            <InputText id="name" class="form-control" @bind-Value="editProduct.Name" />
            <ValidationMessage For="@(() => editProduct.Name)" />
        </div>
        <div class="form-group mb-3">
            <label for="quantity" class="form-label">Quantity</label>
            <InputNumber id="quantity" class="form-control" @bind-Value="editProduct.Quantity" />
            <ValidationMessage For="@(() => editProduct.Quantity)" />
        </div>
        <div class="form-group mb-3">
            <label for="price" class="form-label">Price</label>
            <InputNumber id="price" class="form-control" @bind-Value="editProduct.Price" />
            <ValidationMessage For="@(() => editProduct.Price)" />
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Inventories</label>
            <ProductInventoryComponent Product="this.editProduct"></ProductInventoryComponent>
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
        <a href="/inventories" class="btn btn-primary">Cancel</a>
    </EditForm>
}
@code {
    [Parameter]
    public Guid prodId { get; set; }

    private Product? editProduct;

    protected override async Task OnParametersSetAsync()
    {
        editProduct ??= await ViewProductByIdUseCase.ExecuteAsync(prodId);

        if(editProduct is null)
        {
            NavigationManager.NotFound();
        }
    }
    private async Task Update()
    {
        if(editProduct is not null)
        {
            editProduct.Id = prodId;
            await EditProductUseCase.ExecuteAsync(editProduct);
        }
        
        NavigationManager.NavigateTo("/products");
    }
}
