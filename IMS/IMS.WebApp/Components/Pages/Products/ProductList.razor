@page "/products"
@attribute [Authorize(Policy = "Inventory")]

<h3>Product List</h3>

<br />
<br />

<SearchComponent OnSearch="HandleSearch"></SearchComponent>

<br />

<ProductListComponent searchProductFilter="@productNameFilter"></ProductListComponent>

<br />

<a href="/addproduct" class="btn btn-primary">Add product</a>

@code {
    private string? productNameFilter = string.Empty;
    private void HandleSearch(string searchFilter)
    {
        productNameFilter = searchFilter;
    }
}